# Copy this file to ".env" and paste your real values in.
# NEVER commit the .env file - it is git-ignored on purpose.

# --- Groq (pick rationale text) ---------------------------------
# console.groq.com -> API Keys -> Create API Key
GROQ_API_KEY=gsk_your_key_here

# --- Supabase (database) ----------------------------------------
# Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co

# "anon" / "publishable" key - safe for the dashboard to use
SUPABASE_ANON_KEY=your_anon_key_here

# "service_role" / "secret" key - SERVER ONLY. Never put this in the
# frontend, never commit it, never paste it into a chat window.
SUPABASE_SERVICE_KEY=your_service_role_key_here

# --- Sportsbook lines (v2) --------------------------------------
# the-odds-api.com -> free plan, 500 credits/month.
# Budget: totals + team totals cost ~2 credits a day (60/month). Adding pitcher
# strikeout props costs ~15 more a day (510/month), which is the whole free tier.
# Odds are fetched once per slate and cached, so the five daily runs cost nothing
# extra. Leave blank to run without market lines.
ODDS_API_KEY=
